# Copiar a .env en la raíz y ajustar. No versionar .env.
# Usado por docker compose (stack completo). Defaults alineados con db/.

# --- Puertos publicados en el host ---
DB_PORT=7432
API_PORT=8000
FRONTEND_PORT=3000
OLLAMA_PORT=11434

# --- PostgreSQL (servicio db; mismas credenciales que db/docker-compose.yml) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=embedding_db
# Desde la red Docker el host es "db" y el puerto interno 5432.
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/embedding_db
CATALOG_TABLE=detecciones_catalogo

# --- Ollama (servicio del Compose) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.0
LLM_CACHE_MAXSIZE=256
# Modo Ollama en el host (sin contenedor ollama): ver README.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- CLIP (montaje ./models → /models en el contenedor api) ---
CLIP_MODEL_NAME=clip-ViT-B-32
CLIP_LOCAL_DIR=/models/clip-vit-base-patch32
CLIP_ONNX_BACKEND=false
EMBEDDING_DIM=512

# --- API ---
DEBUG=false
CORS_ORIGINS=["*"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCH=30/minute
DEFAULT_TOP_K=50
DEFAULT_PER_LAYER_LIMIT=100
DEFAULT_MIN_CONFIDENCE=0.0
DEFAULT_SPATIAL_DISTANCE_M=50.0
MAX_SPATIAL_DISTANCE_M=500.0
MAX_QUERY_LENGTH=500

# --- Frontend (embebidas en build; rebuild si cambias) ---
# URL que usa el navegador (no el nombre Docker "api").
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAX_QUERY_LENGTH=500
