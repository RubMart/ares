# Base URL of the ARES FastAPI backend (no trailing slash).
# Prefer 127.0.0.1 over localhost on Windows (avoids IPv6 ::1 when uvicorn binds to 127.0.0.1).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Max search query length (chars). Keep in sync with API MAX_QUERY_LENGTH (default 500).
NEXT_PUBLIC_MAX_QUERY_LENGTH=500
